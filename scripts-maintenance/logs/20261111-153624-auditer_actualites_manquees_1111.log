1/ Definition SQL reelle de vue_changements_indicateurs
================================================================================
WITH classees AS (
  SELECT
    domaine, indicateur, sous_categorie, valeur, unite,
    date_debut_validite, date_verification,
    LAG(valeur) OVER (
      PARTITION BY indicateur, sous_categorie
      ORDER BY date_verification
    ) AS valeur_precedente,
    ROW_NUMBER() OVER (
      PARTITION BY indicateur, sous_categorie
      ORDER BY date_verification DESC
    ) AS rang
  FROM `seo-data-hub-cme.04_pipeline_seo.indicateurs_reglementaires`
)
SELECT
  domaine, indicateur, sous_categorie,
  valeur_precedente, valeur AS valeur_actuelle, unite,
  ROUND(SAFE_DIVIDE(valeur - valeur_precedente, valeur_precedente) * 100, 2) AS variation_pct,
  date_debut_validite, date_verification
FROM classees
WHERE rang = 1
  AND valeur_precedente IS NOT NULL
  AND valeur_precedente != valeur
ORDER BY date_verification DESC

