seo-by-rank-math/includes/rest/class-rest-helper.php :: get_redirection_permissions_check()
====================================================================================================
function get_redirection_permissions_check() {
		if ( ! Helper::is_module_active( 'redirections' ) || ! Helper::has_cap( 'redirections' ) ) {
			return new WP_Error(
				'rest_cannot_edit',
				__( 'Sorry, you are not allowed to create/update redirection.', 'seo-by-rank-math' ),
				[ 'status' => rest_authorization_required_code() ]
			);
		}

		return true;
	}

